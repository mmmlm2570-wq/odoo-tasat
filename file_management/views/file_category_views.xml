<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_file_management_category_list" model="ir.ui.view">
        <field name="name">file.management.category.list</field>
        <field name="model">file.management.category</field>
        <field name="arch" type="xml">
            <list string="File Categories">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_file_management_category_form" model="ir.ui.view">
        <field name="name">file.management.category.form</field>
        <field name="model">file.management.category</field>
        <field name="arch" type="xml">
            <form string="File Category">
                <sheet><group><field name="name"/><field name="active"/></group></sheet>
            </form>
        </field>
    </record>

    <record id="action_file_management_category" model="ir.actions.act_window">
        <field name="name">التصنيفات</field>
        <field name="res_model">file.management.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

